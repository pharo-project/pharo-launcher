"
Pharo Launcher About dialog UI.

Example: 
	self example
"
Class {
	#name : 'PhLAboutPresenter',
	#superclass : 'SpPresenter',
	#instVars : [
		'description',
		'text',
		'icon',
		'documentationLink'
	],
	#category : 'PharoLauncher-Spec2-View',
	#package : 'PharoLauncher-Spec2',
	#tag : 'View'
}

{ #category : 'instance creation' }
PhLAboutPresenter class >> example [
	| text |
	text := PhLAboutCommand new aboutText.
	
	(self text: text iconName: #pharo) openDialog
]

{ #category : 'importing' }
PhLAboutPresenter class >> importImage: anImageFileReference to: aSelector [
	"self importImage: 'pharo-launcher/icons/pharo-launcher.png' asFileReference to: #launcherImageData"

	| base64String methodSource |
	base64String := (Base64MimeConverter mimeEncode:
		                 anImageFileReference binaryReadStream) contents.
	methodSource := String streamContents: [ :stream |
			                stream
				                nextPutAll: aSelector;
				                cr;
				                nextPutAll: '	"generated by ';
				                nextPutAll: thisContext activeHome method name;
				                nextPut: $";
				                cr;
				                nextPut: $^;
				                nextPutAll: base64String surroundedBySingleQuotes ].
	^ self class compile: methodSource classified: 'accessing'
]

